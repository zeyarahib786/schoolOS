# ---- Server ----
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
API_PREFIX=/api/v1

# ---- Database ----
# directConnection=true matters when using the docker-compose MongoDB: the replica set is
# initiated with the in-network hostname mongo:27017, which a HOST-side client cannot
# resolve - directConnection skips topology discovery and connects straight to localhost.
# It is harmless for a plain standalone mongod too, so it is safe as the default.
MONGO_URI=mongodb://localhost:27017/schoolos?directConnection=true

# ---- Auth (generate real random 32+ byte secrets for staging/production - never reuse these) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8090

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000

# ---- Database connection pool (production tuning - defaults are fine for local dev) ----
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2

# ---- Optional external notifications (disabled until school setup is complete) ----
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# SMS provider is deferred. Optional AWS SNS adapter; AWS credentials use the SDK chain.
SMS_PROVIDER=disabled
SMS_AWS_REGION=
SMS_SENDER_ID=
SMS_MAX_PRICE=0.5

# ---- Authorized certificate-based PDF signing ----
# Mount the school's RSA PKCS#12 certificate privately; never commit it.
PDF_SIGNING_P12_PATH=
PDF_SIGNING_P12_PASSPHRASE=
# Optional override; otherwise the bundled OFL Noto Sans Arabic font is used.
PDF_FONT_PATH=

# ---- Operator backup commands only (never place the key in a client build) ----
# Generate/store a separate base64-encoded 32-byte backup key through server secrets.
SCHOOLOS_BACKUP_KEY=
SCHOOLOS_BACKUP_DB=schoolos
# Set yes only after every API, notification worker and other writer has stopped.
SCHOOLOS_BACKUP_WRITES_PAUSED=no
# Optional directory containing official mongodump and mongorestore executables.
SCHOOLOS_DB_TOOLS_DIR=

# Teacher AI Studio (server-side only). No live generation until explicitly enabled.
TEACHER_AI_ENABLED=false
# Supported providers: openai (default), gemini, groq
TEACHER_AI_PROVIDER=openai
OPENAI_API_KEY=
# Gemini key: https://aistudio.google.com/apikey (keep server-side).
GEMINI_API_KEY=
# Groq key: https://console.groq.com/keys (keep server-side).
GROQ_API_KEY=
# Set a structured-output model available to the chosen provider/project.
# Gemini free-tier example: gemini-3.8-flash; check current account quota/pricing.
TEACHER_AI_MODEL=
# Groq example: TEACHER_AI_PROVIDER=groq and TEACHER_AI_MODEL=openai/gpt-oss-20b
# Use a model supporting strict JSON schema. Keys are provider-specific, not interchangeable.

# Stable school prefix for newly issued portal login IDs (e.g. ANS-STU-1042).
SCHOOL_LOGIN_CODE=SCH
