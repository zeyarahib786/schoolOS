# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---- Database ----
# directConnection=true matters when using the docker-compose MongoDB: the replica set is
# initiated with the in-network hostname mongo:27017, which a HOST-side client cannot
# resolve - directConnection skips topology discovery and connects straight to localhost.
# It is harmless for a plain standalone mongod too, so it is safe as the default.
MONGO_URI=mongodb://localhost:27017/schoolos?directConnection=true

# ---- Auth (generate real random 32+ byte secrets for staging/production - never reuse these) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8090

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000

# ---- Database connection pool (production tuning - defaults are fine for local dev) ----
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2
